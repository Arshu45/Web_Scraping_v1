{
  "brand": "Jockey",
  "source_url": "https://jockey.com.au/",
  "spider": "image_promo",
  "extraction_strategy": "text",
  "text_selectors": [
    ".ccb-subtext"
  ],
  "screenshot_selectors": [],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo", "/icon", "/avatar", "social", "payment", "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": false
}
