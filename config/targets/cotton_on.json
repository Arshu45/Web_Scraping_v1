{
  "brand": "Cotton On",
  "source_url": "https://cottonon.com/AU/",
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".trade-tile p.tt",
    ".trade-tile p",
    ".subscription-footer-copy",
    ".meganavbox-title-sale-rectangle",
    ".meganavbox-sale a",
    "div.subscription-footer-copy",
    "p.tt"
  ],
  "screenshot_selectors": [
    ".trade-tiles-four-offers",
    "div.trade-tiles-four-offers",
    ".meganavbox-sale",
    "[class*='trade-tiles']",
    "[class*='meganavbox']"
  ],
  "min_image_width": 300,
  "min_image_height": 100,
  "min_aspect_ratio": 1.0,
  "request_delay_seconds": 4,
  "scroll_depth": 2,
  "enabled": true
}
