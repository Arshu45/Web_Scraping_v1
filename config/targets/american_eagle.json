{
  "brand": "American Eagle",
  "source_url": "https://americaneagle.com.au/",
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".group-block-content",
    ".ann-slide__text",
    ".ann-slide__text p"
  ],
  "screenshot_selectors": [
    ".ai-hero-banner",
    ".background-image-container",
    ".image-block__image",
    "[class*='image-block']",
    "[class*='hero-banner']",
    "[class*='group-block__media']"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo", "/icon", "/avatar", "social", "payment", "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3
}
