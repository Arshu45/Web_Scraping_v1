{
  "brand": "YSL Beauty",
  "source_url": "https://www.yslbeauty.com.au/",
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".c-navigation__content-title"
  ],
  "screenshot_selectors": [
    ".c-navigation__content-image img"
  ],
  "min_image_width": 200,
  "min_image_height": 150,
  "min_aspect_ratio": 0.5,
  "exclude_url_patterns": [
    "/logo", "/icon", "/avatar", "social", "payment", "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": false
}
