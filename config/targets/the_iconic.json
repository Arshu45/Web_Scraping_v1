{
  "brand": "The Iconic",
  "source_url": "https://www.theiconic.com.au/",
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".discover-more-content b",
    ".discover-more-content a",
    ".usp-container a",
    "h1.catalog-title",
    "a[href*='new-customer']",
    "a[href*='referafriend']",
    "span[data-ng-show*='newsletter']",
    ".c01240",
    ".c01243"
  ],
  "screenshot_selectors": [
    "div.dm-sale",
    "div.row.discover-more",
    "section.discover-more-content",
    "[class*='Hero']",
    "[class*='hero']",
    "[class*='Banner']",
    "[class*='banner']",
    "[class*='Editorial']",
    "[class*='editorial']",
    "[class*='Promo']",
    "[class*='promo']",
    "[class*='Campaign']",
    "div.c015",
    "div.c01238",
    "div.c01241"
  ],
  "min_image_width": 600,
  "min_image_height": 150,
  "min_aspect_ratio": 1.5,
  "request_delay_seconds": 4,
  "scroll_depth": 2
}
