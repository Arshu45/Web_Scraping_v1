{
  "brand": "The Iconic",
  "source_url": "https://www.theiconic.com.au/sale/",
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".discover-more-content b",
    ".discover-more-content a",
    ".usp-container a",
    "h1.catalog-title"
  ],
  "screenshot_selectors": [
    "div.dm-sale",
    "div.row.discover-more",
    "section.discover-more-content",
    "[class*='Hero']",
    "[class*='hero']",
    "[class*='Banner']",
    "[class*='banner']",
    "[class*='Editorial']",
    "[class*='editorial']",
    "[class*='Promo']",
    "[class*='promo']",
    "[class*='Campaign']"
  ],
  "min_image_width": 600,
  "min_image_height": 150,
  "min_aspect_ratio": 1.5,
  "request_delay_seconds": 4,
  "scroll_depth": 2
}
