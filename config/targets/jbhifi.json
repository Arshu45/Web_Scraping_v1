{
  "brand": "JB Hi-Fi",
  "source_url": "https://www.jbhifi.com.au",
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    "a[aria-label='Hero Banner']",
    "a[aria-label='Promo Card']"
  ],
  "screenshot_selectors": [
    "div[data-gaip-type='carousel'] img",
    "a[aria-label='Hero Banner'] + img",
    "img[alt*='Big Brand']",
    "img[src*='Big_Brand_Sellout']",
    "a[aria-label='Promo Card']"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": false
}