{
  "brand": "Target",
  "source_url": "https://www.target.com.au",
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    "div._2023-target-section-heading h3",
    "div._2023-target-section-heading p",
    "a[title*='clearance']",
    "a[data-event-promotion-id]"
  ],
  "screenshot_selectors": [
    "div._2023-target-section-heading",
    "a[title*='clearance']"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": true
}
