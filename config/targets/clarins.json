{
  "brand": "Clarins",
  "source_url": [
    "https://www.clarins.com.au/",
    "https://www.clarins.com.au/offers/AU_specialoffers.html"
  ],
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    "i-main-offer-tile",
    ".main-offer-tile",
    ".main-offer-tile-content",
    ".service-tile__description",
    ".offer-wrapper__title",
    ".offer-wrapper__subtitle"
  ],
  "screenshot_selectors": [
    "i-main-offer-tile",
    ".main-offer-tile",
    "img.pagedesigner-image-component"
  ],
  "min_image_width": 300,
  "min_image_height": 100,
  "min_aspect_ratio": 0.8,
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo",
    "payment-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": false
}
