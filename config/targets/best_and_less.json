{
  "brand": "Best & Less",
  "source_url": "https://www.bestandless.com.au/",
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    "app-price-text-image-tile-list .text-section"
  ],
  "screenshot_selectors": [
    "img.image-contain",
    "#Sale-Week-46-Component .image-container img"
  ],
  "min_image_width": 200,
  "min_image_height": 150,
  "min_aspect_ratio": 0.5,
  "exclude_url_patterns": [
    "/logo", "/icon", "/avatar", "social", "payment", "brand-logo"
  ],
  "request_delay_seconds": 6,
  "scroll_depth": 8,
  "enabled": false,
  "promo_keywords_pattern": "\\d+\\s*%|\\boff\\b|\\bsale\\b|\\bdeal\\b|\\bsave\\b|\\bdiscount\\b|\\bextra\\b|free\\s+(?:[a-zA-Z]+\\s+)?(?:delivery|shipping|gift|returns?)|clearance|\\boffer\\b|\\bpromo(?:tion)?\\b|\\bcode\\b|\\bcoupon\\b|\\bvoucher\\b|\\bbogo\\b|buy\\s*\\d+\\s*get\\s*\\d+|\\b\\d+\\s*for\\s*\\d+\\b|\\bmembers?\\b.{0,15}\\b(save|only|exclusive|price|pricing)\\b|\\bfor\\s+[A-Za-z]{0,3}[\\$£€¥₹]\\d|\\bfrom\\s+[A-Za-z]{0,3}[\\$£€¥₹]\\d|\\bonly\\s+[A-Za-z]{0,3}[\\$£€¥₹]\\d|[\\$£€¥₹]\\d+\\s*\\*|[\\$£€¥₹]\\d+\\s*each"
}
