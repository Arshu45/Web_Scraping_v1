{
  "brand": "House",
  "source_url": "https://www.house.com.au",
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".PromoBanner-module__rkZKbW__promoBannerRotating p"
  ],
  "screenshot_selectors": [
    "img[alt='HOUSE BIG BRANDS SALE']",
    "img[src*='HSE_BIGBRANDSSALE']",
    "img[src*='BIGBRANDS']",
    "img[src*='HERODESKTOP']"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo",
    "/icon",
    "/avatar",
    "social",
    "payment",
    "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": false
  
}