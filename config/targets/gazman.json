{
  "brand": "Gazman",
  "source_url": "https://www.gazman.com.au/",
  "spider": "image_promo",
  "extraction_strategy": "screenshot",
  "text_selectors": [],
  "screenshot_selectors": [
    ".mixed-content__block img",
    "a[href='/collections/sale-pants-jeans'] img"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 0.5,
  "exclude_url_patterns": [
    "/logo", "/icon", "/avatar", "social", "payment", "brand-logo"
  ],
  "request_delay_seconds": 6,
  "scroll_depth": 5
}
