{
  "brand": "Review Australia",
  "source_url": "https://review-australia.com",
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".klaviyo-form-richtext",
    "[data-topbar-message]",
    "[id^='hero-template--'] h2",
    "[id^='hero-template--'] p",
    ".js-newsletter-form h3"
  ],
  "screenshot_selectors": [
    ".plp-banner",
    ".plp-banner img"
  ],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo", "/icon", "/avatar", "social", "payment", "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": false  
}