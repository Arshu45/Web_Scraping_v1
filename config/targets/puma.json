{
  "brand": "Puma",
  "source_url": [
    "https://au.puma.com/au/en/home",
    "https://au.puma.com/au/en/sale"
  ],
  "spider": "image_promo",
  "extraction_strategy": "hybrid",
  "text_selectors": [
    ".vertical-text",
    ".p-promo-bar-item-label",
    ".p-bottom-promo-copy"
  ],
  "screenshot_selectors": [],
  "min_image_width": 400,
  "min_image_height": 150,
  "min_aspect_ratio": 1.2,
  "exclude_url_patterns": [
    "/logo", "/icon", "/avatar", "social", "payment", "brand-logo"
  ],
  "request_delay_seconds": 4,
  "scroll_depth": 3,
  "enabled": false
}
