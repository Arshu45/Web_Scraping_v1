# Database Connection URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/promo_db_v3

# OPTION A: Direct Gemini API (Standard)
# Required if not using LiteLLM. Get a key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_vision_api_key_here

# OPTION B: Corporate LiteLLM Proxy (Optional)
# If your company routes AI calls through a gateway, define these:
LITELLM_API_KEY=your_corporate_litellm_api_key
LITELLM_API_BASE=https://your-company-gateway-url/v1
VISION_LLM_MODEL=gemini/gemini-2.5-flash
