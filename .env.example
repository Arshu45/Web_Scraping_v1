# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=promo_scraper
DB_USER=postgres
DB_PASSWORD=your_password_here

# Enrichment provider: "gliner" (local, no API key) or "groq" (fast, needs API key)
ENRICHMENT_PROVIDER=gliner

# Required only when ENRICHMENT_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
